{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/GFBitches/*.png",
        "type": "auto",
        "height": 15,
        "width": 30,
        "padding": {
        "top": 1,
        "left": 3

    },
   },
    "display": {
        "separator": "  "
    },
    "modules": [
	"break",
	"break",
	{
             "type": "host",
            "key": " ",
            "keyColor": "#365c72",
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "#365c72",
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "#365c72",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "#75333c",
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "#75333c",
        },
        {
            "type": "de",
            "key": " ",
            "keyColor": "#75333c",
        },
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "#5d7434"
        },
        {
            "key": " {#keys}",
            "type": "memory",
            "keyColor": "#5d7434"
        },
        {
            "type": "gpu",
            "key": " ",
            "keyColor": "#5d7434"
        },


        "break",

        {
        "key": "󰔟 ",
        "keyColor": "#a3c79e",
        "type": "command",
        "text": "birth_install=$(stat -c %W /); current=$(date +%s);    days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days",
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "#a3c79e",
        },
                {
            "type": "media",
            "key": "󰝚 ",
            "keyColor": "#a3c79e",
        },

    ]
}
